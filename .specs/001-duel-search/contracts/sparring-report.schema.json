{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiger-engine.local/contracts/sparring-report.v1.schema.json",
  "$comment": "contract: sparring-report; version: 1.0.0; captured: 2026-09-18; source: spec.md criterion 8 and Constitution Article XIV",
  "x-contract": "sparring-report",
  "x-version": "1.0.0",
  "x-captured": "2026-09-18",
  "title": "Sparring benchmark report",
  "type": "object",
  "required": ["schema_version", "engine", "environment", "matchups"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "engine": {
      "type": "object",
      "required": ["name", "commit"],
      "properties": {
        "name": { "type": "string" },
        "commit": { "type": "string", "minLength": 7 }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["cpu", "kernel", "rustc", "rules_cli_release"],
      "properties": {
        "cpu": { "type": "string" },
        "kernel": { "type": "string" },
        "rustc": { "type": "string" },
        "rules_cli_release": { "type": "string" }
      },
      "additionalProperties": false
    },
    "matchups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["challenger", "opponent", "seeds", "wins", "losses", "draws", "win_rate", "win_rate_wilson95"],
        "properties": {
          "challenger": { "type": "string" },
          "opponent": { "type": "string" },
          "seeds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 }
          },
          "wins": { "type": "integer", "minimum": 0 },
          "losses": { "type": "integer", "minimum": 0 },
          "draws": { "type": "integer", "minimum": 0 },
          "win_rate": { "type": "number", "minimum": 0, "maximum": 1 },
          "win_rate_wilson95": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "mean_turns": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
