{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiger-engine.local/contracts/melee-report.v1.schema.json",
  "$comment": "contract: melee-report; version: 1.0.0; captured: 2026-09-19; source: 003-melee-search spec.md criterion 6 and Constitution Article XIV",
  "x-contract": "melee-report",
  "x-version": "1.0.0",
  "x-captured": "2026-09-19",
  "title": "Four-snake placement benchmark report",
  "type": "object",
  "required": ["schema_version", "engine", "environment", "games", "summary"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "engine": {
      "type": "object",
      "required": ["name", "commit"],
      "properties": {
        "name": { "type": "string" },
        "commit": { "type": "string", "minLength": 7 }
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["cpu", "kernel", "rustc", "rules_cli_release"],
      "properties": {
        "cpu": { "type": "string" },
        "kernel": { "type": "string" },
        "rustc": { "type": "string" },
        "rules_cli_release": { "type": "string" }
      },
      "additionalProperties": false
    },
    "games": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["seat_one", "seed", "turns", "placements"],
        "properties": {
          "seat_one": { "type": "string", "description": "The challenger's or the baseline's id: who sat in seat one for this game." },
          "seed": { "type": "integer", "minimum": 0 },
          "turns": { "type": "integer", "minimum": 0 },
          "placements": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["snake", "place"],
              "properties": {
                "snake": { "type": "string" },
                "place": { "type": "number", "minimum": 1, "maximum": 4, "description": "1 is the last snake alive; snakes eliminated in the same turn share the average of their places." }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["challenger", "baseline", "reference_opponent", "challenger_mean", "baseline_mean", "reference_mean_in_challenger_games", "opponents", "criterion_met"],
      "properties": {
        "challenger": { "type": "string" },
        "baseline": { "type": "string" },
        "reference_opponent": { "type": "string", "description": "The roster's first opponent (Sansón), whose mean placement in the challenger's games the challenger must not exceed." },
        "challenger_mean": { "type": "number", "minimum": 1, "maximum": 4 },
        "baseline_mean": { "type": "number", "minimum": 1, "maximum": 4 },
        "reference_mean_in_challenger_games": { "type": "number", "minimum": 1, "maximum": 4 },
        "opponents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "mean_with_challenger", "mean_with_baseline"],
            "properties": {
              "id": { "type": "string" },
              "mean_with_challenger": { "type": "number", "minimum": 1, "maximum": 4 },
              "mean_with_baseline": { "type": "number", "minimum": 1, "maximum": 4 }
            },
            "additionalProperties": false
          }
        },
        "criterion_met": { "type": "boolean", "description": "challenger_mean < baseline_mean and challenger_mean <= reference_mean_in_challenger_games" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
